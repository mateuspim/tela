#!/usr/bin/env bash
# Run any flutter/dart command inside the pinned toolchain container.
#
#   ./tool/tela analyze
#   ./tool/tela test
#   ./tool/tela build apk --release
#   ./tool/tela deploy [--edition safe] [host:port] # build release + install, safely
#   ./tool/tela signing-setup      # fetch the release key from Vaultwarden
#   ./tool/tela adb <args>         # raw adb inside the container
#   ./tool/tela devices
#   ./tool/tela --shell          # drop into the container
#   ./tool/tela --build-image    # (re)build the toolchain image
#
# Caches (pub, gradle) live in named volumes, so they survive `--rm` and a
# second `test` run doesn't re-resolve the world. So does ~/.android, which is
# not a cache: it holds the debug signing key, and a run that re-mints it forces
# a clean reinstall that wipes the app's data.
#
# To put a build on a device, use `deploy`. It builds the *universal* release
# APK (using the versionCode in pubspec.yaml) and installs it with `adb install -r`, which can only
# update in place — it cannot uninstall, so it cannot take the Drift database or
# the Keystore-backed API key with it.
#
# Never use `flutter install` or `flutter run` here, and never build
# `--split-per-abi` for a device. `flutter install` uninstalls first,
# unconditionally — that alone cost the device's accumulated database once
# (2026-07-14), with a perfectly matching signature. A `--split-per-abi` arm64
# APK is versionCode 2001; installing it makes the next versionCode-1 build a
# downgrade, which `flutter run` then "fixes" by uninstalling. `deploy` avoids
# both traps by construction.
set -euo pipefail

IMAGE="tela-toolchain"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# A root host is its own case, and it has to be handled in both directions.
#
# The image builds a `dev` user owning the invoking uid, so that files written
# into the bind mount come back out owned by you. That cannot be done for uid 0:
# the step evicts whoever already holds the uid first, which as root is
# `userdel -r root`, and the build dies at `useradd` with a bare `exit code: 4`.
#
# So build `dev` at the default uid and then don't use it — run the container as
# root instead, which can write a root-owned repo and a dev-owned volume alike.
# HOME still has to point at /home/dev, or the named caches (pub, gradle, and
# the debug keystore below) mount at a path nothing reads.
HOST_IS_ROOT=false
[[ "$(id -u)" == 0 ]] && HOST_IS_ROOT=true

build_image() {
  local uid gid
  uid="$(id -u)"
  gid="$(id -g)"
  if [[ "$HOST_IS_ROOT" == true ]]; then
    uid=1000
    gid=1000
  fi
  docker build \
    --build-arg "UID=$uid" \
    --build-arg "GID=$gid" \
    -t "$IMAGE" \
    -f "$REPO_ROOT/tool/docker/Dockerfile" \
    "$REPO_ROOT/tool/docker"
}

case "${1:-}" in
  --build-image) build_image; exit 0 ;;
  # On the host, not in the container: it needs the owner's `bw` session.
  signing-setup) exec "$REPO_ROOT/tool/signing-setup" ;;
esac

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "toolchain image missing — building it once…" >&2
  build_image
fi

# --network host: lets the container's adb reach Waydroid, which listens on the
# host's waydroid0 bridge rather than on anything Docker can see from a bridge net.
# /dev/bus/usb: the physical-device path for adb.
#
# --memory: a ceiling the *kernel* enforces, because the JVM's own is advisory.
# The toolchain runs on a 6 GB host with 2 GB of swap, and an unbounded Gradle
# daemon expanding into that made the machine unresponsive rather than making
# the build fail (owner, 2026-08-12) — a hung host reports nothing, so the
# failure has to be contained where it can still be read. 4 GB leaves the host
# its own working set; `android/gradle.properties` sizes the JVMs to fit inside
# it, and if one ever escapes that, the OOM killer takes the container and the
# build says so.
DOCKER_ARGS=(
  --rm
  --memory 4g
  --memory-swap 5g
  --network host
  -v "$REPO_ROOT:/app"
  -v "tela-pub-cache:/home/dev/.pub-cache"
  -v "tela-gradle:/home/dev/.gradle"
  # The debug signing key. Without it every run signs the APK with a new key,
  # Android refuses the update, and `flutter run` uninstalls the app to get out
  # of it — taking the stored API key and the database with it.
  -v "tela-android:/home/dev/.android"
  -w /app
  # Pointed at the volumes explicitly, because `HOME` is not enough to get them
  # used. The JVM takes `user.home` from the **passwd entry**, not from `$HOME`,
  # so Gradle running as uid 0 (see HOST_IS_ROOT below) resolved its cache to
  # `/root/.gradle` — outside every mount — and re-downloaded the whole 100 MB
  # Gradle distribution on each run, unzipping it again for good measure. These
  # two env vars are read ahead of any home directory by Gradle and pub
  # respectively, so they hold for both users. Same paths under the `dev` user,
  # so this changes nothing there.
  -e GRADLE_USER_HOME=/home/dev/.gradle
  -e PUB_CACHE=/home/dev/.pub-cache
  # Forwarded only when set. A release build without android/key.properties
  # fails unless this is 1 — see build.gradle.kts.
  -e TELA_ALLOW_DEBUG_SIGNING
)

# See HOST_IS_ROOT above: as root the image's `dev` user is the wrong one to be,
# because everything in the bind mount belongs to root and dev cannot write it —
# which surfaces as `Flutter failed to write to a file at "/app/.dart_tool"`.
[[ "$HOST_IS_ROOT" == true ]] && DOCKER_ARGS+=(--user 0:0 -e HOME=/home/dev)

[[ -d /dev/bus/usb ]] && DOCKER_ARGS+=(-v /dev/bus/usb:/dev/bus/usb --device-cgroup-rule='c 189:* rmw')
[[ -t 0 ]] && DOCKER_ARGS+=(-it)

if [[ "${1:-}" == "--shell" ]]; then
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" bash
fi

# `dart` is not reachable through `flutter` (there is no `flutter format` any
# more), so pass it through as its own entrypoint: ./tool/tela dart format .
if [[ "${1:-}" == "dart" ]]; then
  shift
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" dart "$@"
fi

# The native (Kotlin) suite. `flutter test` runs Dart only and never reaches
# android/, so these need their own door. They are JVM unit tests, so no
# emulator and no device is involved — Gradle and Robolectric do it all in here.
if [[ "${1:-}" == "kotlin-test" ]]; then
  shift
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" \
    bash -c 'cd android && ./gradlew --console=plain :app:testFullDebugUnitTest "$@"' bash "$@"
fi

# adb is its own entrypoint too: ./tool/tela adb devices, ./tool/tela adb logcat.
if [[ "${1:-}" == "adb" ]]; then
  shift
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" adb "$@"
fi

# keytool, for `signing-setup`'s certificate check. The store password travels
# as an env var named on the command line (`-storepass:env`), never as an arg.
if [[ "${1:-}" == "keytool" ]]; then
  shift
  exec docker run "${DOCKER_ARGS[@]}" -e TELA_STORE_PASSWORD "$IMAGE" keytool "$@"
fi

# deploy: the one blessed way onto a device. Build the universal release APK,
# then `adb install -r` it and relaunch. An optional host:port is `adb connect`ed
# first (for a networked device); with no argument it uses the single attached
# one. `install -r` can only update in place — it never uninstalls, so it never
# takes the Drift database or the API key with it, the way `flutter install/run`
# do. See the header for why nothing else is safe.
if [[ "${1:-}" == "deploy" ]]; then
  shift
  edition=full
  if [[ "${1:-}" == "--edition" ]]; then
    edition="${2:?deploy --edition needs one of full|safe|wallhaven|play}"
    shift 2
  fi
  case "$edition" in
    full|safe|wallhaven|play) ;;
    *) echo "deploy: edition must be full|safe|wallhaven|play, got \"$edition\"" >&2; exit 2 ;;
  esac
  target="${1:-}"
  docker run "${DOCKER_ARGS[@]}" "$IMAGE" flutter build apk --release \
    --flavor "$edition" --dart-define=TELA_EDITION="$edition"
  # Before installing, the certificate the device already trusts is compared
  # with the one just built. A mismatch is refused here, in words, instead of
  # surfacing as INSTALL_FAILED_UPDATE_INCOMPATIBLE — whose only "fix" is an
  # uninstall that takes the private library with it (2026-08-11).
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" bash -c '
    set -euo pipefail
    edition="$1"; target="${2:-}"
    apk="build/app/outputs/flutter-apk/app-$edition-release.apk"
    pkg=cc.pym.tela; [[ "$edition" == full ]] || pkg="cc.pym.tela.$edition"
    signer="$(find "$ANDROID_SDK_ROOT/build-tools" -name apksigner | sort -V | tail -1)"
    digests() { "$signer" verify --print-certs "$1" | sed -n "s/^.*certificate SHA-256 digest: //p" | sort -u; }
    if [[ -n "$target" ]]; then
      adb connect "$target" >/dev/null || true
      dev=(-s "$target")
    else
      dev=()
    fi
    # Unreachable must stop here: read as "not installed", it would skip the
    # certificate check below.
    adb "${dev[@]}" get-state >/dev/null
    installed="$(adb "${dev[@]}" shell pm path "$pkg" | sed -n "s/^package://p" | grep base.apk || true)"
    if [[ -n "$installed" ]]; then
      adb "${dev[@]}" pull "$installed" /tmp/installed.apk >/dev/null
      if [[ "$(digests /tmp/installed.apk)" != "$(digests "$apk")" ]]; then
        echo "deploy: $pkg on the device is signed by $(digests /tmp/installed.apk)," >&2
        echo "deploy: this build by $(digests "$apk"). Not installing — and never uninstall." >&2
        echo "deploy: run ./tool/tela signing-setup to build with the release key." >&2
        exit 1
      fi
    fi
    adb "${dev[@]}" install -r "$apk"
    adb "${dev[@]}" shell am force-stop "$pkg"
    adb "${dev[@]}" shell am start -n "$pkg/cc.pym.tela.MainActivity"
  ' bash "$edition" "$target"
fi

exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" flutter "$@"
