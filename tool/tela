#!/usr/bin/env bash
# Run any flutter/dart command inside the pinned toolchain container.
#
#   ./tool/tela analyze
#   ./tool/tela test
#   ./tool/tela build apk --release
#   ./tool/tela deploy [host:port] # build release + install on a device, safely
#   ./tool/tela adb <args>         # raw adb inside the container
#   ./tool/tela devices
#   ./tool/tela --shell          # drop into the container
#   ./tool/tela --build-image    # (re)build the toolchain image
#
# Caches (pub, gradle) live in named volumes, so they survive `--rm` and a
# second `test` run doesn't re-resolve the world. So does ~/.android, which is
# not a cache: it holds the debug signing key, and a run that re-mints it forces
# a clean reinstall that wipes the app's data.
#
# To put a build on a device, use `deploy`. It builds the *universal* release
# APK (versionCode 1) and installs it with `adb install -r`, which can only
# update in place — it cannot uninstall, so it cannot take the Drift database or
# the Keystore-backed API key with it.
#
# Never use `flutter install` or `flutter run` here, and never build
# `--split-per-abi` for a device. `flutter install` uninstalls first,
# unconditionally — that alone cost the device's accumulated database once
# (2026-07-14), with a perfectly matching signature. A `--split-per-abi` arm64
# APK is versionCode 2001; installing it makes the next versionCode-1 build a
# downgrade, which `flutter run` then "fixes" by uninstalling. `deploy` avoids
# both traps by construction.
set -euo pipefail

IMAGE="tela-toolchain"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

build_image() {
  docker build \
    --build-arg "UID=$(id -u)" \
    --build-arg "GID=$(id -g)" \
    -t "$IMAGE" \
    -f "$REPO_ROOT/tool/docker/Dockerfile" \
    "$REPO_ROOT/tool/docker"
}

case "${1:-}" in
  --build-image) build_image; exit 0 ;;
esac

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "toolchain image missing — building it once…" >&2
  build_image
fi

# --network host: lets the container's adb reach Waydroid, which listens on the
# host's waydroid0 bridge rather than on anything Docker can see from a bridge net.
# /dev/bus/usb: the physical-device path for adb.
DOCKER_ARGS=(
  --rm
  --network host
  -v "$REPO_ROOT:/app"
  -v "tela-pub-cache:/home/dev/.pub-cache"
  -v "tela-gradle:/home/dev/.gradle"
  # The debug signing key. Without it every run signs the APK with a new key,
  # Android refuses the update, and `flutter run` uninstalls the app to get out
  # of it — taking the stored API key and the database with it.
  -v "tela-android:/home/dev/.android"
  -w /app
)

[[ -d /dev/bus/usb ]] && DOCKER_ARGS+=(-v /dev/bus/usb:/dev/bus/usb --device-cgroup-rule='c 189:* rmw')
[[ -t 0 ]] && DOCKER_ARGS+=(-it)

if [[ "${1:-}" == "--shell" ]]; then
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" bash
fi

# `dart` is not reachable through `flutter` (there is no `flutter format` any
# more), so pass it through as its own entrypoint: ./tool/tela dart format .
if [[ "${1:-}" == "dart" ]]; then
  shift
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" dart "$@"
fi

# The native (Kotlin) suite. `flutter test` runs Dart only and never reaches
# android/, so these need their own door. They are JVM unit tests, so no
# emulator and no device is involved — Gradle and Robolectric do it all in here.
if [[ "${1:-}" == "kotlin-test" ]]; then
  shift
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" \
    bash -c 'cd android && ./gradlew --console=plain :app:testDebugUnitTest "$@"' bash "$@"
fi

# adb is its own entrypoint too: ./tool/tela adb devices, ./tool/tela adb logcat.
if [[ "${1:-}" == "adb" ]]; then
  shift
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" adb "$@"
fi

# deploy: the one blessed way onto a device. Build the universal release APK,
# then `adb install -r` it and relaunch. An optional host:port is `adb connect`ed
# first (for a networked device); with no argument it uses the single attached
# one. `install -r` can only update in place — it never uninstalls, so it never
# takes the Drift database or the API key with it, the way `flutter install/run`
# do. See the header for why nothing else is safe.
if [[ "${1:-}" == "deploy" ]]; then
  shift
  target="${1:-}"
  docker run "${DOCKER_ARGS[@]}" "$IMAGE" flutter build apk --release
  exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" bash -c '
    set -euo pipefail
    apk="build/app/outputs/flutter-apk/app-release.apk"
    target="${1:-}"
    if [[ -n "$target" ]]; then
      adb connect "$target" >/dev/null || true
      dev=(-s "$target")
    else
      dev=()
    fi
    adb "${dev[@]}" install -r "$apk"
    adb "${dev[@]}" shell am force-stop cc.pym.tela
    adb "${dev[@]}" shell am start -n cc.pym.tela/.MainActivity
  ' bash "$target"
fi

exec docker run "${DOCKER_ARGS[@]}" "$IMAGE" flutter "$@"
