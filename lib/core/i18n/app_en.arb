  "@offloadWaitingForScreen": {
    "description": "Shown when copying finished while the app was backgrounded. The gallery delete goes through MediaStore.createDeleteRequest, which needs an Activity; without this the run would look stalled for a reason nobody could guess."
  },

  "offloadStop": "Stop",
  "@offloadStop": {
