    "description": "Confirmation title before moving downloads into the private library.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "moveToPrivateBody": "{count, plural, =1{The file leaves Photos and moves behind the app lock. tela cannot move it back into Photos afterwards — to get it there again you would download it fresh.} other{The {count} files leave Photos and move behind the app lock. tela cannot move them back into Photos afterwards — to get them there again you would download them fresh.}}",
  "@moveToPrivateBody": {
    "description": "Says both halves plainly: where the file goes, and that the trip is one-way. The private tier keeps no record of what it holds beyond a file name, so tela can never prove a private image is safe for Photos — a user who is not told that will discover it when they try to undo the move.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "moveToPrivateDone": "{count, plural, =1{Moved to the private library} other{Moved {count} to the private library}}",
  "@moveToPrivateDone": {
    "description": "Confirms every wallpaper in the move landed in the private library.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "moveToPrivatePartial": "Moved {moved} of {total} — the rest are where they were",
  "@moveToPrivatePartial": {
    "description": "Reports a move where some files did not go — a dismissed system delete prompt, or a copy that failed. Says the rest are unchanged rather than leaving the user to guess whether they are now in two places, which is the outcome the rollback exists to prevent.",
    "placeholders": {
      "moved": {
        "type": "int"
      },
      "total": {
        "type": "int"
      }
    }
  },

  "moveOutOfPrivateAction": "Move out",
  "@moveOutOfPrivateAction": {
    "description": "Label and confirm button for moving an image out of the private library into the files folder."
  },

  "moveOutOfPrivateTitle": "{count, plural, =1{Move this out of the private library?} other{Move {count} images out of the private library?}}",
  "@moveOutOfPrivateTitle": {
    "description": "Confirmation title before moving images out of the private library."
  },

  "moveOutOfPrivateBody": "{count, plural, =1{It moves to your downloads folder, where any file manager can reach it — never to Photos, because tela cannot tell whether a private image is safe to show there. tela stops tracking it: it will not appear anywhere in the app afterwards.} other{They move to your downloads folder, where any file manager can reach them — never to Photos, because tela cannot tell whether a private image is safe to show there. tela stops tracking them: they will not appear anywhere in the app afterwards.}}",
  "@moveOutOfPrivateBody": {
    "description": "The two surprises this move holds, said before it happens: it cannot go to Photos, and the image leaves every tela screen. Moving out of the private library sounds like it lands somewhere else in the app, and it does not — there is no history row to write, because the private tier keeps no wallpaper to write one from.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "moveOutOfPrivateDone": "{count, plural, =1{Moved to your downloads folder} other{Moved {count} to your downloads folder}}",
  "@moveOutOfPrivateDone": {
    "description": "Confirms images left the private library for the files folder. Names the destination rather than saying 'moved out', which would leave the user hunting for them.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "moveOutOfPrivatePartial": "Moved {moved} of {total} — the rest are still private",
  "@moveOutOfPrivatePartial": {
    "description": "Reports a partial move out of the private library, saying where the remainder still is.",
    "placeholders": {
      "moved": {
        "type": "int"
      },
      "total": {
        "type": "int"
      }
    }
  },

  "moveFailure": "Could not move that. Nothing changed.",
  "@moveFailure": {
    "description": "Shown when the move itself failed. The second sentence is the point: the rollback means a failed move leaves the file exactly where it was, never in two places."
  },

