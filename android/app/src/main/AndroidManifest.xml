<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- All three are normal permissions: granted at install, no runtime prompt.
         There is deliberately no storage permission here — minSdk 29 means every
         supported device has scoped storage, so MediaStore writes need none.
         USE_BIOMETRIC is the private library's optional app-lock; it lets tela
         ask BiometricPrompt to verify the owner, and grants no access to any
         biometric data itself. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.SET_WALLPAPER"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- The download queue's foreground service, and both are normal
         permissions too. dataSync is the type that fits: the service transfers
         the user's chosen files and ends when they have landed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <!-- Runtime-prompted from API 33, and tela deliberately never asks. A
         foreground service still runs when it is denied — only its shade entry
         is suppressed — so the queue keeps its anchor either way, and the
         download the user just asked for is a poor moment to interrupt with a
         permission dialog. Declared so the notification shows for anyone who
         has already allowed tela's notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Two things are excluded from both backup paths: the API key, which is
         encrypted with a Keystore key that no backup carries, so a restored
         copy would be undecryptable; and the app-private storage tier
         (filesDir/wallpapers), because a private library in the user's cloud
         account is not private. Backup stays enabled for everything else — the
         database and the destination settings restore normally.
         See res/xml/backup_rules.xml, and BackupExclusionTest. -->
    <application
        android:label="tela"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Anchors the process while the download queue drains; it never
             downloads anything itself. exported=false because nothing outside
             tela may start it.

             stopWithTask=false is what keeps it running when the user swipes
             tela out of recents, which is the gesture the queue exists to
             survive. It is only honest because the Flutter engine is cached on
             the process (TelaEngine) rather than owned by MainActivity, so the
             drain the notification describes really is still going. -->
        <service
            android:name=".DownloadQueueService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync"/>

        <!-- Exposes a single cached image to the app the user shares to, through a
             one-shot read grant. exported=false + grantUriPermissions means no
             other app can reach tela's files except the exact URI it is handed.
             Only non-explicit wallpapers are ever written here — the domain
             refuses to share an explicit image file (ShareWallpaper.image). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- So url_launcher can resolve a browser for "View on Wallhaven" and
             a wallpaper's source under Android 11+ package visibility. Without
             it, launchUrl finds no handler and the link silently fails. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
