<?xml version="1.0" encoding="utf-8"?>
<!--
  The window Android paints before Flutter draws its first frame. Was
  @android:color/white here and ?android:colorBackground in drawable-v21, so a
  launch of a dark-first app could flash pale.

  The ground is the icon's ground, NOT a theme surface, and it is deliberately
  the same in light and dark: tapping the icon should land on the thing you
  tapped. A theme-following splash would need a second, darker mark to keep the
  light warp tint legible on a pale ground — two marks to keep in step, for a
  band that shows for a few hundred milliseconds.

  This copy is unreachable at minSdk 29 (drawable-v21 wins) and is kept only
  so the two cannot drift. On API 31+ both are superseded by the system
  splash screen; see values-v31/styles.xml.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/telaBrandGround" />

    <item
        android:width="192dp"
        android:height="192dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
