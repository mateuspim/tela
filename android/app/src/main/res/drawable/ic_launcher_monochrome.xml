<?xml version="1.0" encoding="utf-8"?>
<!--
  The Material You themed-icon layer: the same mark as one flat silhouette.

  This is not a redundant copy of ic_launcher_foreground — it is the case the
  mark's geometry was designed around. The system discards these colours and
  tints the whole shape from the user's wallpaper, so the over-under has to be
  legible with no tone difference at all. It is: each band is shortened at the
  end that passes under, and those cuts are what keep the frame from reading as
  a closed square here.

  The fill is white only so the shape is visible if anything ever renders it
  untinted; the system's tint replaces it. Geometry is verbatim from
  assets/brand/tela_mark.svg — see docs/BRAND.md.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

