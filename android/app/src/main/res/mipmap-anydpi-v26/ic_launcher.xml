<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive launcher icon. minSdk is 29, so this always wins over the PNG
  mipmaps beside it — those are kept only so nothing stale can surface.

  The monochrome layer is the reason the mark is built out of cuts rather than
  tones; see ic_launcher_monochrome.xml.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/telaBrandGround" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
